<UserControl x:Class="CustomMediaPlayerUltimate.Elements.PlayingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomMediaPlayerUltimate.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="30">
    <UserControl.Resources>
        <Storyboard x:Key="AnimationStoryboard">
            <DoubleAnimation BeginTime="0" Duration="0:0:0.6" RepeatBehavior="Forever" AutoReverse="True" From="0.25" To="0.9" Storyboard.TargetName="FirstBar" Storyboard.TargetProperty="ScaleY">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="2"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation BeginTime="0" Duration="0:0:0.45" RepeatBehavior="Forever" AutoReverse="True" From="0.1" To="0.85" Storyboard.TargetName="SecondBar" Storyboard.TargetProperty="ScaleY">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="2"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation BeginTime="0" Duration="0:0:0.55" RepeatBehavior="Forever" AutoReverse="True" From="0.3" To="0.9" Storyboard.TargetName="ThirdBar" Storyboard.TargetProperty="ScaleY">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="2"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation BeginTime="0" Duration="0:0:0.4" RepeatBehavior="Forever" AutoReverse="True" From="0.15" To="0.8" Storyboard.TargetName="FourthBar" Storyboard.TargetProperty="ScaleY">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="2"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <Viewbox>
        <Grid>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard x:Name="BGS" Storyboard="{Binding Source={StaticResource AnimationStoryboard}}"/>
                </EventTrigger>
            </Grid.Triggers>

            <Rectangle Width="256" Height="256"/>
            <Path Fill="WhiteSmoke">
                <Path.Data>
                    <RectangleGeometry Rect="40,8,32,240"/>
                </Path.Data>
                <Path.RenderTransform>
                    <ScaleTransform x:Name="FirstBar" ScaleX="1" ScaleY="0.25"/>
                </Path.RenderTransform>
                <Path.RenderTransformOrigin>
                    <Point X="0.5" Y="1.0"/>
                </Path.RenderTransformOrigin>
            </Path>
            <Path Fill="WhiteSmoke">
                <Path.Data>
                    <RectangleGeometry Rect="88,8,32,240"/>
                </Path.Data>
                <Path.RenderTransform>
                    <ScaleTransform x:Name="SecondBar" ScaleX="1" ScaleY="0.1"/>
                </Path.RenderTransform>
                <Path.RenderTransformOrigin>
                    <Point X="0.5" Y="1.0"/>
                </Path.RenderTransformOrigin>
            </Path>
            <Path Fill="WhiteSmoke">
                <Path.Data>
                    <RectangleGeometry Rect="136,8,32,240"/>
                </Path.Data>
                <Path.RenderTransform>
                    <ScaleTransform x:Name="ThirdBar" ScaleX="1" ScaleY="0.3"/>
                </Path.RenderTransform>
                <Path.RenderTransformOrigin>
                    <Point X="0.5" Y="1.0"/>
                </Path.RenderTransformOrigin>
            </Path>
            <Path Fill="WhiteSmoke">
                <Path.Data>
                    <RectangleGeometry Rect="184,8,32,240"/>
                </Path.Data>
                <Path.RenderTransform>
                    <ScaleTransform x:Name="FourthBar" ScaleX="1" ScaleY="0.15"/>
                </Path.RenderTransform>
                <Path.RenderTransformOrigin>
                    <Point X="0.5" Y="1.0"/>
                </Path.RenderTransformOrigin>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
